rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Attendance Records: Shared cross-device access for dredger supervisors and office authority
    match /attendance_records/{date} {
      allow read, write: if true;
    }

    // Pending Submissions awaiting Office Authority review
    match /pending_submissions/{submissionId} {
      allow read, write: if true;
    }

    // Supervisors Directory (phone numbers, group assignments)
    match /supervisors/{supervisorId} {
      allow read, write: if true;
    }

    // System & Office Settings
    match /app_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
